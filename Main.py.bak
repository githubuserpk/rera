def add_footer():
    """Adds a custom footer to the Streamlit app."""
    st.markdown("---")  # Add a horizontal rule for visual separation
    st.markdown(
        """
        <style>
        .footer {
            position: fixed;
            left: 0;
            bottom: 0;
            width: 100%;
            background-color: #f0f0f0;
            color: #666;
            text-align: center;
            padding: 10px 0;
        }
        </style>
        <div class="footer">
            &copy; 2024 AIGard | All Rights Reserved
        </div>
        """,
        unsafe_allow_html=True,
    )

   

